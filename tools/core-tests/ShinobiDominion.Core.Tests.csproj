<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compiles the engine-free Core and its tests outside Unity, for a fast check.
       LangVersion 9 matches what Unity 6 supports, so this catches newer syntax too. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\unity\Assets\_Game\Scripts\Core\**\*.cs" />
    <Compile Include="..\..\unity\Assets\_Game\Tests\EditMode\**\*.cs" />
    <Content Include="..\..\unity\Assets\_Game\Resources\Config\buildings.json" Link="Config\buildings.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\unity\Assets\_Game\Resources\Config\heroes.json" Link="Config\heroes.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\unity\Assets\_Game\Tests\EditMode\rules_vectors.json" Link="Config\rules_vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\unity\Assets\_Game\Tests\EditMode\battle_vectors.json" Link="Config\battle_vectors.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\unity\Assets\_Game\Resources\Config\raids.json" Link="Config\raids.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\unity\Assets\_Game\Resources\Config\troops.json" Link="Config\troops.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\unity\Assets\_Game\Resources\Config\spells.json" Link="Config\spells.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
  </ItemGroup>
</Project>
