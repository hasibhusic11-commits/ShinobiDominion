# Copy to .env and replace every value. Never commit .env.
POSTGRES_PASSWORD=replace-me
SD_SERVER_KEY=replace-me
SD_SESSION_KEY=replace-me
SD_REFRESH_KEY=replace-me
SD_HTTP_KEY=replace-me
SD_CONSOLE_USER=admin
SD_CONSOLE_PASSWORD=replace-me
SD_CONSOLE_KEY=replace-me

# true enables development-only grants and audit calls. Must be false anywhere real.
SD_DEV_MODE=true
# Mutation rate limit per player. The test suite needs it high; use 5 and 20 outside tests.
SD_RATE_PER_SEC=100000
SD_RATE_BURST=100000
