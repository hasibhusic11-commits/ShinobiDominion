      "ops": [
        { "op": "place", "def": "mana_mill", "x": 1, "z": 1, "expect": "None", "label": "m", "gold": 4400, "mana": 0 },
        { "op": "collect", "target": "m", "expect": "NothingToCollect", "mana": 0 },
        { "op": "advanceHours", "hours": 1 },
        { "op": "collect", "target": "m", "expect": "None", "gold": 4400, "mana": 200 },
