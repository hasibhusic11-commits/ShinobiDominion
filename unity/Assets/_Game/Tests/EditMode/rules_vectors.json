        { "op": "setMana", "mana": 1000 },
        { "op": "train", "troop": "militia", "count": 1, "expect": "InsufficientFunds", "gold": 0, "mana": 1000 }
      ]
    },
    {
      "name": "hero training buys one level with mana and keeps earned xp",
