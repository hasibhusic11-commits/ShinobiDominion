        { "op": "advanceHours", "hours": 1000 },
        { "op": "collect", "target": "m", "expect": "None", "mana": 1000 },
        { "op": "upgrade", "target": "m", "expect": "None", "gold": 3800, "level": 2 },
        { "op": "advanceHours", "hours": 1 },
        { "op": "collect", "target": "m", "expect": "None", "mana": 1280 }
      ]
    },
    {
      "name": "training refuses when short of mana and charges nothing",
