{
  "comment": "Run by both the C# client rules and the Go server rules, which must give identical answers.",
  "starter": [
    { "def": "dojo_hq", "x": 22, "z": 22 },
    { "def": "builder_hall", "x": 16, "z": 23 },
    { "def": "hero_altar", "x": 29, "z": 22 },
    { "def": "summoning_gate", "x": 23, "z": 30 },
    { "def": "gold_mine", "x": 18, "z": 16 },
    { "def": "hero_base", "x": 19, "z": 29 },
    { "def": "hero_base", "x": 29, "z": 29 }
  ],
  "scenarios": [
    {
      "name": "map edges",
      "startGold": 5000,
      "ops": [
        { "op": "place", "def": "hero_base", "x": 48, "z": 48, "expect": "None", "gold": 4600 },
        { "op": "place", "def": "hero_base", "x": 49, "z": 49, "expect": "OutOfBounds" },
        { "op": "place", "def": "hero_base", "x": 50, "z": 0, "expect": "OutOfBounds" },
        { "op": "place", "def": "hero_base", "x": -1, "z": 0, "expect": "OutOfBounds" },
        { "op": "place", "def": "hero_base", "x": 0, "z": -1, "expect": "OutOfBounds", "gold": 4600 },
        { "op": "walls", "x": 49, "z": 49, "x2": 49, "z2": 49, "expect": "Overlap" },
        { "op": "walls", "x": 50, "z": 0, "x2": 50, "z2": 0, "expect": "OutOfBounds", "gold": 4600 }
      ]
    },
    {
      "name": "last cell of the map",
      "startGold": 5000,
      "ops": [
        { "op": "walls", "x": 49, "z": 49, "x2": 49, "z2": 49, "expect": "None", "gold": 4975 },
        { "op": "occupied", "x": 49, "z": 49, "expect": "true" }
      ]
    },
    {
      "name": "overlap",
      "startGold": 5000,
      "ops": [
        { "op": "walls", "x": 10, "z": 10, "x2": 10, "z2": 10, "expect": "None", "gold": 4975 },
        { "op": "place", "def": "defense_tower", "x": 9, "z": 9, "expect": "Overlap" },
        { "op": "place", "def": "defense_tower", "x": 20, "z": 20, "expect": "None", "gold": 4375 },
        { "op": "place", "def": "defense_tower", "x": 21, "z": 21, "expect": "Overlap", "gold": 4375 }
      ]
    },
    {
      "name": "cannot afford",
      "startGold": 0,
      "ops": [
        { "op": "place", "def": "defense_tower", "x": 1, "z": 1, "expect": "InsufficientFunds", "count": 0 },
        { "op": "walls", "x": 0, "z": 0, "x2": 9, "z2": 0, "expect": "InsufficientFunds", "gold": 0 }
      ]
    },
    {
      "name": "exactly six hero bases",
      "startGold": 5000,
      "ops": [
        { "op": "place", "def": "hero_base", "x": 0, "z": 0, "expect": "None" },
        { "op": "place", "def": "hero_base", "x": 3, "z": 0, "expect": "None" },
        { "op": "place", "def": "hero_base", "x": 6, "z": 0, "expect": "None" },
        { "op": "place", "def": "hero_base", "x": 9, "z": 0, "expect": "None" },
        { "op": "place", "def": "hero_base", "x": 12, "z": 0, "expect": "None" },
        { "op": "place", "def": "hero_base", "x": 15, "z": 0, "expect": "None", "gold": 2600 },
        { "op": "place", "def": "hero_base", "x": 30, "z": 30, "expect": "LimitReached", "gold": 2600, "countDef": "hero_base", "count": 6 }
      ]
    },
    {
      "name": "rotation",
      "startGold": 5000,
      "ops": [
        { "op": "place", "def": "training_grounds", "x": 0, "z": 47, "expect": "None", "label": "t", "gold": 3500 },
        { "op": "move", "target": "t", "x": 0, "z": 47, "rotation": 1, "expect": "OutOfBounds" },
        { "op": "move", "target": "t", "x": 0, "z": 46, "rotation": 1, "expect": "None" },
        { "op": "occupied", "x": 2, "z": 49, "expect": "true" },
        { "op": "occupied", "x": 3, "z": 49, "expect": "false" },
        { "op": "place", "def": "hero_base", "x": 20, "z": 20, "rotation": 1, "expect": "NotRotatable" },
        { "op": "place", "def": "hero_base", "x": 20, "z": 20, "expect": "None", "label": "b" },
        { "op": "move", "target": "b", "x": 20, "z": 20, "rotation": 1, "expect": "NotRotatable" }
      ]
    },
    {
      "name": "moving",
      "startGold": 5000,
      "ops": [
        { "op": "place", "def": "hero_base", "x": 5, "z": 5, "expect": "None", "label": "a" },
        { "op": "place", "def": "defense_tower", "x": 10, "z": 10, "expect": "None" },
        { "op": "move", "target": "a", "x": 10, "z": 10, "expect": "Overlap" },
        { "op": "occupied", "x": 5, "z": 5, "expect": "true" },
        { "op": "move", "target": "a", "x": 6, "z": 6, "expect": "None" },
        { "op": "occupied", "x": 5, "z": 5, "expect": "false" },
        { "op": "occupied", "x": 7, "z": 7, "expect": "true" },
        { "op": "move", "target": "a", "x": 7, "z": 7, "expect": "None", "gold": 4000 }
      ]
    },
    {
      "name": "removing",
      "startGold": 5000,
      "ops": [
        { "op": "place", "def": "builder_hall", "x": 1, "z": 1, "expect": "None", "label": "h" },
        { "op": "remove", "target": "h", "expect": "NotRemovable" },
        { "op": "remove", "id": 999, "expect": "NotFound" },
        { "op": "walls", "x": 8, "z": 8, "x2": 8, "z2": 8, "expect": "None" },
        { "op": "remove", "atX": 8, "atZ": 8, "expect": "None", "gold": 4975 },
        { "op": "occupied", "x": 8, "z": 8, "expect": "false" },
        { "op": "walls", "x": 8, "z": 8, "x2": 8, "z2": 8, "expect": "None", "gold": 4950 }
      ]
    },
    {
      "name": "upgrading",
      "startGold": 5000,
      "ops": [
        { "op": "place", "def": "hero_base", "x": 1, "z": 1, "expect": "None", "label": "a", "gold": 4600 },
        { "op": "upgrade", "target": "a", "expect": "None", "gold": 4200, "level": 2 },
        { "op": "place", "def": "summoning_gate", "x": 10, "z": 10, "expect": "None", "label": "g" },
        { "op": "setLevel", "target": "g", "level": 15 },
        { "op": "upgrade", "target": "g", "expect": "MaxLevel" },
        { "op": "upgrade", "id": 999, "expect": "NotFound" },
        { "op": "setGold", "gold": 100 },
        { "op": "upgrade", "target": "a", "expect": "InsufficientFunds", "gold": 100, "level": 2 }
      ]
    },
    {
      "name": "the dojo gates upgrades, every 3 levels from level 5",
      "startGold": 20000,
      "ops": [
        { "op": "place", "def": "hero_base", "x": 1, "z": 1, "expect": "None", "label": "b" },
        { "op": "setLevel", "target": "b", "level": 4 },
        { "op": "upgrade", "target": "b", "expect": "DojoTooLow", "level": 4 },
        { "op": "place", "def": "dojo_hq", "x": 22, "z": 22, "expect": "None", "label": "d" },
        { "op": "setLevel", "target": "d", "level": 3 },
        { "op": "upgrade", "target": "b", "expect": "None", "level": 5 },
        { "op": "setLevel", "target": "b", "level": 7 },
        { "op": "upgrade", "target": "b", "expect": "DojoTooLow", "level": 7 },
        { "op": "setLevel", "target": "d", "level": 6 },
        { "op": "upgrade", "target": "b", "expect": "None", "level": 8 },
        { "op": "walls", "x": 30, "z": 40, "x2": 31, "z2": 40, "expect": "None" },
        { "op": "setLevel", "atX": 30, "atZ": 40, "level": 10 },
        { "op": "setLevel", "atX": 31, "atZ": 40, "level": 10 },
        { "op": "upgradeGroup", "atX": 30, "atZ": 40, "expect": "DojoTooLow", "level": 10 },
        { "op": "setLevel", "atX": 31, "atZ": 40, "level": 9 },
        { "op": "upgradeGroup", "atX": 30, "atZ": 40, "expect": "None", "level": 10 },
        { "op": "levelAt", "x": 31, "z": 40, "expect": "10" }
      ]
    },
    {
      "name": "upgrades use each building's own table",
      "startGold": 20000,
      "ops": [
        { "op": "place", "def": "gold_mine", "x": 1, "z": 1, "expect": "None", "label": "m" },
        { "op": "upgrade", "target": "m", "expect": "None", "gold": 19400, "level": 2 },
        { "op": "advanceHours", "hours": 1 },
        { "op": "collect", "target": "m", "expect": "None", "gold": 20000 },
        { "op": "place", "def": "gold_vault", "x": 10, "z": 10, "expect": "None", "gold": 19500, "label": "v" },
        { "op": "upgrade", "target": "v", "expect": "None", "gold": 19100, "level": 2 }
      ]
    },
    {
      "name": "wall runs are atomic and never diagonal",
      "startGold": 5000,
      "ops": [
        { "op": "place", "def": "defense_tower", "x": 5, "z": 0, "expect": "None", "gold": 4400 },
        { "op": "walls", "x": 0, "z": 0, "x2": 9, "z2": 0, "expect": "Overlap", "gold": 4400, "countDef": "wall", "count": 0 },
        { "op": "walls", "x": 45, "z": 0, "x2": 50, "z2": 0, "expect": "OutOfBounds", "gold": 4400, "countDef": "wall", "count": 0 },
        { "op": "walls", "x": 20, "z": 20, "x2": 25, "z2": 22, "expect": "None", "countDef": "wall", "count": 6 },
        { "op": "occupied", "x": 25, "z": 20, "expect": "true" },
        { "op": "occupied", "x": 25, "z": 22, "expect": "false" },
        { "op": "walls", "x": 30, "z": 30, "x2": 32, "z2": 32, "expect": "None", "countDef": "wall", "count": 9 },
        { "op": "occupied", "x": 32, "z": 30, "expect": "true" },
        { "op": "walls", "x": 40, "z": 40, "x2": 41, "z2": 45, "expect": "None", "countDef": "wall", "count": 15 },
        { "op": "occupied", "x": 40, "z": 45, "expect": "true" },
        { "op": "walls", "x": 15, "z": 0, "x2": 15, "z2": -3, "expect": "OutOfBounds", "countDef": "wall", "count": 15 }
      ]
    },
    {
      "name": "wall limit",
      "startGold": 5000,
      "ops": [
        { "op": "walls", "x": 0, "z": 0, "x2": 49, "z2": 0, "expect": "None", "gold": 3750 },
        { "op": "walls", "x": 0, "z": 1, "x2": 10, "z2": 1, "expect": "LimitReached", "gold": 3750 },
        { "op": "walls", "x": 0, "z": 1, "x2": 9, "z2": 1, "expect": "None", "gold": 3500, "countDef": "wall", "count": 60 }
      ]
    },
    {
      "name": "connected wall upgrade",
      "startGold": 5000,
      "ops": [
        { "op": "walls", "x": 0, "z": 0, "x2": 4, "z2": 0, "expect": "None" },
        { "op": "walls", "x": 4, "z": 1, "x2": 4, "z2": 3, "expect": "None" },
        { "op": "walls", "x": 20, "z": 20, "x2": 21, "z2": 20, "expect": "None", "gold": 4750 },
        { "op": "upgradeGroup", "atX": 0, "atZ": 0, "expect": "None", "gold": 4590, "level": 2 },
        { "op": "levelAt", "x": 4, "z": 3, "expect": "2" },
        { "op": "levelAt", "x": 20, "z": 20, "expect": "1" },
        { "op": "setGold", "gold": 1 },
        { "op": "upgradeGroup", "atX": 20, "atZ": 20, "expect": "InsufficientFunds", "gold": 1 },
        { "op": "setGold", "gold": 5000 },
        { "op": "place", "def": "hero_base", "x": 30, "z": 30, "expect": "None", "label": "b" },
        { "op": "upgradeGroup", "target": "b", "expect": "NotAWall" },
        { "op": "upgradeGroup", "id": 999, "expect": "NotFound" }
      ]
    },
    {
      "name": "dojo level sets limits",
      "startGold": 20000,
      "ops": [
        { "op": "place", "def": "dojo_hq", "x": 22, "z": 22, "expect": "None", "label": "d" },
        { "op": "place", "def": "dojo_hq", "x": 0, "z": 0, "expect": "LimitReached" },
        { "op": "place", "def": "defense_tower", "x": 0, "z": 0, "expect": "None" },
        { "op": "place", "def": "defense_tower", "x": 3, "z": 0, "expect": "None" },
        { "op": "place", "def": "defense_tower", "x": 6, "z": 0, "expect": "LimitReached" },
        { "op": "place", "def": "research_hut", "x": 10, "z": 10, "expect": "LimitReached" },
        { "op": "upgrade", "target": "d", "expect": "None", "level": 2 },
        { "op": "place", "def": "defense_tower", "x": 6, "z": 0, "expect": "None" },
        { "op": "place", "def": "research_hut", "x": 10, "z": 10, "expect": "None" },
        { "op": "place", "def": "nope", "x": 40, "z": 40, "expect": "UnknownBuilding" }
      ]
    },
    {
      "name": "collecting gold",
      "startGold": 5000,
      "ops": [
        { "op": "place", "def": "gold_mine", "x": 1, "z": 1, "expect": "None", "label": "m", "gold": 4700 },
        { "op": "collect", "target": "m", "expect": "NothingToCollect", "gold": 4700 },
        { "op": "advanceHours", "hours": 1 },
        { "op": "collect", "target": "m", "expect": "None", "gold": 5300 },
        { "op": "collect", "target": "m", "expect": "NothingToCollect", "gold": 5300 },
        { "op": "advanceHours", "hours": 1000 },
        { "op": "collect", "target": "m", "expect": "None", "gold": 7700 },
        { "op": "place", "def": "hero_base", "x": 20, "z": 20, "expect": "None", "label": "b" },
        { "op": "collect", "target": "b", "expect": "NotACollector" },
        { "op": "collect", "id": 999, "expect": "NotFound" }
      ]
    },
    {
      "name": "storage limits keep the remainder in the mine",
      "startGold": 5000,
      "ops": [
        { "op": "place", "def": "gold_mine", "x": 1, "z": 1, "expect": "None", "label": "m" },
        { "op": "setGold", "gold": 19900 },
        { "op": "advanceHours", "hours": 10 },
        { "op": "collect", "target": "m", "expect": "None", "gold": 20000 },
        { "op": "collect", "target": "m", "expect": "StorageFull", "gold": 20000 },
        { "op": "place", "def": "gold_vault", "x": 10, "z": 10, "expect": "None", "gold": 19500 },
        { "op": "collect", "target": "m", "expect": "None", "gold": 21800 }
      ]
    },
    {
      "name": "crystal mine pays crystals",
      "startGold": 20000,
      "startCrystals": 7,
      "ops": [
        { "op": "place", "def": "crystal_mine", "x": 1, "z": 1, "expect": "LimitReached" },
        { "op": "place", "def": "dojo_hq", "x": 22, "z": 22, "expect": "None", "label": "d" },
        { "op": "upgrade", "target": "d", "expect": "None" },
        { "op": "place", "def": "crystal_mine", "x": 1, "z": 1, "expect": "None", "label": "c" },
        { "op": "advanceHours", "hours": 2 },
        { "op": "collect", "target": "c", "expect": "None", "crystals": 15 },
        { "op": "advanceHours", "hours": 100 },
        { "op": "collect", "target": "c", "expect": "None", "crystals": 31 }
      ]
    }
  ]
}
