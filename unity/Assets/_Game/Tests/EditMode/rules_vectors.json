      "startMana": 100,
      "ops": [
        { "op": "trainHero", "heroLevel": 1, "heroXp": 50, "expect": "None", "toLevel": 2, "toXp": 50, "mana": 80 },
        { "op": "trainHero", "heroLevel": 3, "heroXp": 0, "expect": "None", "toLevel": 4, "toXp": 0, "mana": 50 },
        { "op": "trainHero", "heroLevel": 10, "heroXp": 0, "expect": "InsufficientMana", "toLevel": 10, "mana": 50 },
        { "op": "trainHero", "heroLevel": 1, "heroXp": 115, "expect": "None", "toLevel": 3, "toXp": 5, "mana": 30 },
        { "op": "trainHero", "heroLevel": 200, "heroXp": 0, "expect": "AtMaxLevel", "toLevel": 200, "mana": 30 },
        { "op": "setMana", "mana": 1010 },
        { "op": "trainHero", "heroLevel": 199, "heroXp": 900, "expect": "None", "toLevel": 200, "toXp": 0, "mana": 0 }
